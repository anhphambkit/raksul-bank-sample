# Nuxt reads .env during dev/build/preview. Copy this file to .env.
# Deployment: provide these variables to the running Node/Nitro server.
NUXT_PUBLIC_ENABLE_MOCKS=true
# For backend SSR: set mocks to false and set the private upstream API root.
# Browser calls stay same-origin /api/*; Nitro forwards to this root.
# NUXT_API_BASE_URL=https://banking.example.com/api
